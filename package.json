{
  "name": "french-learning-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:curriculum": "node scripts/validate-curriculum.mjs",
    "validate:questions": "node scripts/validate-questions.mjs",
    "test": "node --test \"tests/**/*.test.mjs\" && vitest run",
    "review:sheet": "node scripts/review-sheet.mjs",
    "review:apply": "node scripts/apply-review.mjs",
    "qa": "node scripts/qa-report.mjs",
    "dev": "node scripts/build-bank.mjs && vite",
    "build": "node scripts/build-bank.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "preact": "10.29.8",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.6",
    "fake-indexeddb": "6.2.7",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  }
}
