{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "objective.schema.json",
  "title": "Learning objective",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "level", "domain", "skill", "description", "prerequisites", "question_types", "source_refs", "provenance", "verification_status"],
  "properties": {
    "id": { "type": "string", "pattern": "^FR-(A1|A2|B1|B2)-(GRM|VOC|REA|LIS|WRI|SPK|PRA|ADV)-[0-9]{3}$" },
    "version": { "type": "integer", "minimum": 1 },
    "level": { "enum": ["A1", "A2", "B1", "B2"] },
    "domain": { "enum": ["GRM", "VOC", "REA", "LIS", "WRI", "SPK", "PRA", "ADV"] },
    "skill": { "type": "string", "minLength": 3, "maxLength": 80, "description": "Short label, plain English" },
    "description": { "type": "string", "minLength": 20, "description": "What the learner can do, in everyday English, no unexplained grammar terms" },
    "terms_introduced": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "plain_explanation"],
        "properties": { "term": { "type": "string" }, "plain_explanation": { "type": "string" } }
      }
    },
    "examples": { "type": "array", "items": { "type": "string" }, "description": "1-3 short French examples with English gloss" },
    "prerequisites": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "question_types": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["mcq", "fill_blank", "sentence_completion", "sentence_order", "translate_en_fr", "translate_fr_en", "error_correction", "reading_comprehension", "listening_comprehension", "spoken_response", "extended_writing"] }
    },
    "source_refs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["source_id"],
        "properties": { "source_id": { "type": "string" }, "note": { "type": "string" } }
      }
    },
    "provenance": { "enum": ["ai-drafted", "human-written"] },
    "verification_status": { "enum": ["ai-drafted", "checked-against-source", "approved"] },
    "notes": { "type": "string" }
  }
}
