{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question.schema.json",
  "title": "Practice question",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "level", "objective_id", "format", "prompt", "answer", "acceptable_alternatives", "hint", "explanation", "difficulty", "status", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^Q-(A1|A2|B1|B2)-(GRM|VOC|REA|LIS|WRI|SPK|PRA|ADV)-[0-9]{3}-[0-9]{3}$", "description": "Q-<objective suffix>-<nnn>" },
    "version": { "type": "integer", "minimum": 1 },
    "level": { "enum": ["A1", "A2", "B1", "B2"] },
    "objective_id": { "type": "string" },
    "variant_group": { "type": "string", "description": "Questions sharing a group test the same item with surface changes; the engine avoids counting them as independent evidence" },
    "format": { "enum": ["mcq", "fill_blank", "sentence_completion", "sentence_order", "translate_en_fr", "translate_fr_en", "error_correction", "reading_comprehension", "listening_comprehension", "spoken_response", "extended_writing"] },
    "instruction": { "type": "string", "description": "Short task line in English, e.g. 'Fill the gap.'" },
    "passage": { "type": "string", "description": "Reading text or audio transcript, if any" },
    "prompt": { "type": "string", "minLength": 1, "description": "Use ___ for the gap in fill_blank" },
    "choices": { "type": "array", "items": { "type": "string" }, "minItems": 2, "description": "mcq, reading_comprehension, listening_comprehension" },
    "tokens": { "type": "array", "items": { "type": "string" }, "description": "sentence_order only: shuffled words" },
    "answer": { "type": "string" },
    "acceptable_alternatives": { "type": "array", "items": { "type": "string" } },
    "answer_check": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["exact", "normalised", "model_assessed"], "default": "normalised" },
        "accent_policy": { "enum": ["strict", "near_miss"], "default": "near_miss", "description": "near_miss: right apart from accents is shown as almost right, not correct" }
      }
    },
    "hint": { "type": "string", "minLength": 1 },
    "explanation": { "type": "string", "minLength": 1, "description": "Plain English, no unexplained grammar terms" },
    "wrong_answer_feedback": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Map of a likely wrong answer to a targeted explanation" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "status": { "enum": ["generated", "structurally_validated", "ai_reviewed", "linguistically_verified", "approved", "rejected"] },
    "flags": { "type": "array", "items": { "type": "string" } },
    "review_notes": { "type": "string" },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["method", "date"],
      "properties": {
        "method": { "enum": ["ai-generated", "human-written", "adapted"] },
        "model_tier": { "enum": ["haiku", "sonnet", "opus"] },
        "batch_id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "source_note": { "type": "string" }
      }
    }
  }
}
